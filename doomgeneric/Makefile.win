################################################################
# Makefile.win - MinGW-w64 build of doomgeneric WITH SDL2 sound
# Based on Makefile.sdl. Build from an MSYS2 MinGW64 shell:
#   make -f Makefile.win
################################################################

ifeq ($(V),1)
	VB=''
else
	VB=@
endif

SDL_CFLAGS = `sdl2-config --cflags`
SDL_LIBS = `sdl2-config --libs` -lSDL2_mixer

CC=gcc
# -std=gnu11: doomgeneric predates C23, which turns true/false/bool into
# keywords and breaks doomtype.h's enum { false, true }. gcc 16 defaults to C23.
CFLAGS+=-DFEATURE_SOUND $(SDL_CFLAGS) -O2 -Wall -std=gnu11
LDFLAGS+=
# NOTE: no -lc on MinGW (the C runtime is linked automatically).
LIBS+=-lm $(SDL_LIBS)

# subdirectory for objects
OBJDIR=build
OUTPUT=doomgeneric.exe

SRC_DOOM = dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_main.o w_wad.o z_zone.o w_file_stdc.o i_input.o i_video.o doomgeneric.o doomgeneric_sdl.o mus2mid.o i_sdlmusic.o i_sdlsound.o
OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))

all:	 $(OUTPUT)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT)
	rm -f $(OUTPUT).gdb
	rm -f $(OUTPUT).map

$(OUTPUT):	$(OBJS)
	@echo [Linking $@]
	$(VB)$(CC) $(CFLAGS) $(LDFLAGS) $(OBJS) \
	-o $(OUTPUT) $(LIBS)

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJDIR)/%.o:	%.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

print:
	@echo OBJS: $(OBJS)

# Header dependency tracking (at end so it doesn't hijack the default goal):
# rebuild objects when an included header changes. gcc -MMD writes a .d file
# per object; -MP adds phony targets for headers.
-include $(OBJS:.o=.d)
